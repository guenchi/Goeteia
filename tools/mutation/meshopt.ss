;; the counts and strides test/meshopt.ss gives each buffer
(define (decode! name n)
  (cond ((string=? name "bv0") (meshopt-vertex! BASE n DST 24 4) (meshopt-filter-oct! DST 24 4))
        ((string=? name "bv1") (meshopt-vertex! BASE n DST 24 8))
        ((string=? name "bv2") (meshopt-index! BASE n DST 36 2))
        ((string=? name "fidx") (meshopt-index! BASE n DST 1728 2))
        (else (meshopt-vertex! BASE n DST 163 12) (meshopt-filter-exp! DST 163 12))))
