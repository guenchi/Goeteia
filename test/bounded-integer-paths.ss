;; expect: #t
;; Exercise public conversion and modulo, with an unchanged remainder oracle.
(import (rnrs) (sim grid))
(define checks 0)
(define (check ok)
  (unless ok (error 'bounded-integer-paths "Exact numeric behavior changed" checks))
  (set! checks (+ checks 1)))
(define (reference-mod n d)
  (let ((r (remainder n d))) (if (< r 0) (+ r (abs d)) r)))
(define (check-mod n d)
  (let ((r (mod n d)))
    (check (equal? r (reference-mod n d)))
    (check (and (exact? r) (integer? r) (<= 0 r) (< r (abs d))))))
(define divisors '(-536870912 -536870911 -65537 -32768 -3 -2 -1 1 2 3 32768 65537 536870911))
(for-each (lambda (n) (for-each (lambda (d) (check-mod n d)) divisors))
  '(-1000000000000000000 -536870913 -536870912 -536870911 -65538 -65537 -65536 -1 0 1
    65536 65537 65538 536870910 536870911 536870912 1000000000000000000))
(do ((i -8192 (+ i 31))) ((> i 8192))
  (for-each (lambda (delta)
    (let ((n (+ (* i 65537) delta)))
      (for-each (lambda (d) (check-mod n d)) '(65537 -65537 536870911 -536870912)))) '(-1 0 1)))
(do ((i -1000 (+ i 17))) ((> i 1000))
  (for-each (lambda (d) (check-mod (+ 536870400 i) d) (check-mod (- -536870400 i) d)) divisors))
(for-each (lambda (pair) (check-mod (car pair) (cdr pair)))
  '((1 . 536870912) (-1 . -536870913) (536870911 . 1000000000000000000)))
(define (refused? n d)
  (guard (e (#t (eq? (condition-who e) 'mod))) (mod n d) #f))
(for-each (lambda (pair) (check (refused? (car pair) (cdr pair))))
  '((1 . 0) (0 . 0) (1/3 . 2) (1 . 2.0) (1.0 . 2) (wrong . 2)))
(for-each (lambda (n)
  (let ((x (inexact n)))
    (check (equal? (exact x) n))
    (check (equal? (inexact->exact x) n))))
  '(-1099511627776 -536870913 -536870912 -536870911 -1 0 1 536870910 536870911 536870912 1099511627776))
(for-each (lambda (pair) (check (equal? (exact (car pair)) (cdr pair))))
  '((0.5 . 1/2) (-0.5 . -1/2) (536870911.5 . 1073741823/2)
    (-536870912.5 . -1073741825/2) (0.0 . 0) (-0.0 . 0)))
(check (equal? (exact 7/3) 7/3))
(check (equal? (exact 536870912) 536870912))
(check (not (fixnum? (exact 536870912.0))))
(check (fixnum? (exact -536870912.0)))
(check (= (grid-cell -0.5 32.0) -1))
(check (= (grid-cell -32.0 32.0) -1))
(check (= (grid-cell 32.0 32.0) 1))
(> checks 18000)
