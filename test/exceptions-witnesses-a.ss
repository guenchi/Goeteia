;; expect: #t
;; R6RS exception semantics, witnessed against Chez 10 (ledger R20f):
;; main's nineteen witnesses and the first read's twenty-eight: handlers that return, guards that
;; do not match under them, tests that read what an after thunk restores, thunks that raise or
;; escape in the middle of a leave or a re-entry, 300 nested guards.
;;
;; Every `run' evaluates a thunk under one outermost guard and records
;; (name value trace); the trace is what the thunks noted, in order.  The
;; expected list is what Chez prints for this same text with its own
;; dynamic-wind, with-exception-handler, raise, raise-continuable, guard
;; and call/cc.  goeteia's continuations only escape; these rows are the
;; ones that say a guard which does not match still behaves as if the
;; body had been left and entered again.
;;
;; ON THE TREE BEFORE THE CHANGE this file does not compile
;; (with-exception-handler is unbound).
(import (rnrs))
(define kk #f)
(define trace '())
(define (note x) (set! trace (cons x trace)))
(define (nc? c) (and (condition? c) (non-continuable-violation? c)))
(define results '())
(define (shown c)
  (if (condition? c)
      (if (non-continuable-violation? c) 'non-continuable 'condition)
      c))
(define (run name thunk)
  (set! trace '())
  (let ((v (guard (c (#t (list 'escaped (shown c)))) (thunk))))
    (set! results (cons (list name v (reverse trace)) results))))

(run 'w1 (lambda () (with-exception-handler (lambda (c) (note (list 'h c)) 10)
                      (lambda () (+ 1 (raise-continuable 'c1))))))
(run 'w2 (lambda () (with-exception-handler (lambda (c) (note 'outer) (if (nc? c) 'nc 'other))
                      (lambda () (with-exception-handler (lambda (c) (note 'inner) 5)
                                   (lambda () (+ 1 (raise 'c2))))))))
(run 'w3 (lambda () (with-exception-handler (lambda (c) (note (list 'outer c)) 100)
                      (lambda () (with-exception-handler (lambda (c) (note (list 'inner c)) (+ 1 (raise-continuable 'again)))
                                   (lambda () (raise-continuable 'first)))))))
(run 'w4 (lambda () (with-exception-handler (lambda (c) (note (list 'h c)) 7)
                      (lambda () (guard (e ((string? e) 'string))
                                   (+ 1 (raise-continuable 'sym)))))))
(run 'w5 (lambda () (with-exception-handler (lambda (c) (note (list 'h c)) 7)
                      (lambda () (guard (e ((string? e) 'string))
                                   (dynamic-wind (lambda () (note 'in))
                                                   (lambda () (+ 1 (raise-continuable 'sym)))
                                                   (lambda () (note 'out))))))))
(run 'w6 (lambda () (guard (e ((symbol? e) (note 'outer-clause) 'outer))
                      (guard (e ((string? e) 'inner))
                        (dynamic-wind (lambda () (note 'in)) (lambda () (raise 'boom)) (lambda () (note 'out)))))))
(define locked #f)
(run 'w7 (lambda () (guard (e ((not locked) 'matched) (else 'fell))
                      (dynamic-wind (lambda () (set! locked #t)) (lambda () (raise 'x)) (lambda () (set! locked #f))))))
(run 'w8 (lambda () (guard (e (#t (note 'clause) 'caught))
                      (dynamic-wind (lambda () (note 'in)) (lambda () (raise 'x)) (lambda () (note 'out))))))
(run 'w9 (lambda () (list (guard (e ((assq 'a e) => cdr) ((assq 'b e))) (raise (list (cons 'a 42))))
                          (guard (e ((assq 'a e) => cdr) ((assq 'b e))) (raise (list (cons 'b 23)))))))
(run 'w10 (lambda () (let ((r (call/cc (lambda (k) (with-exception-handler (lambda (c) (note 'stale) 0) (lambda () (k 'left)))))))
                       (list r (guard (e (#t 'fresh)) (raise 'later))))))
(run 'w14 (lambda () (guard (e ((string? e) 'err)) (raise 42))))
(run 'w15 (lambda () (call-with-values (lambda () (guard (e (#t 0)) (values 1 2))) list)))
(run 'w16 (lambda () (call-with-values (lambda () (with-exception-handler (lambda (c) 0) (lambda () (values 1 2 3)))) list)))
;; three more, on the hard corners
;; 17 an after thunk that raises while the guard is leaving: the guard's own handler gets it (nested)
(run 'w17 (lambda () (guard (e ((symbol? e) (note (list 'clause e)) e))
                       (dynamic-wind (lambda () (note 'in))
                                       (lambda () (raise 'first))
                                       (lambda () (note 'out) (when (= 1 (length (filter (lambda (t) (eq? t 'out)) trace))) (raise 'from-after)))))))
;; 18 a handler inside the guard passes on; the guard does not match; the outermost returns
(run 'w18 (lambda () (with-exception-handler (lambda (c) (note (list 'outer c)) 1)
                       (lambda () (guard (e ((string? e) 'string))
                                    (with-exception-handler (lambda (c) (note (list 'inner c)) (* 10 (raise-continuable c)))
                                      (lambda () (dynamic-wind (lambda () (note 'in))
                                                                 (lambda () (+ 5 (raise-continuable 'q)))
                                                                 (lambda () (note 'out))))))))))
;; 19 a clause test that escapes to a continuation taken inside the body
(run 'w19 (lambda () (guard (e ((kk 'via-test) 'never))
                       (dynamic-wind (lambda () (note 'in))
                                       (lambda () (list 'body (call/cc (lambda (k) (set! kk k) (raise 'x)))))
                                       (lambda () (note 'out))))))


(define cnt 0)
(define flag 0)
;; n1 a clause test that raise-continuables, answered by an outer handler that returns
(run 'n1 (lambda () (with-exception-handler (lambda (c) (note (list 'h c)) #t)
  (lambda () (guard (e ((raise-continuable (list 'test e)) 'tested))
     (dynamic-wind (lambda () (note 'in)) (lambda () (raise 'b)) (lambda () (note 'out))))))))
;; n2 a clause test that raises, caught by run's outer guard
(run 'n2 (lambda () (guard (e ((raise (list 'test e)) 'tested))
     (dynamic-wind (lambda () (note 'in)) (lambda () (raise 'b)) (lambda () (note 'out))))))
;; n3 a before thunk that raise-continuables during the re-entry
(set! cnt 0)
(run 'n3 (lambda () (with-exception-handler (lambda (c) (note (list 'h c)) 1)
  (lambda () (guard (e ((string? e) 's))
     (dynamic-wind (lambda () (set! cnt (+ cnt 1)) (note (list 'in cnt))
                        (when (= cnt 2) (note (list 'bret (raise-continuable 'from-before)))))
                     (lambda () (+ 10 (raise-continuable 'sym)))
                     (lambda () (note 'out))))))))
;; n4 an after thunk that escapes during the guard's leave, to a continuation outside the guard
(run 'n4 (lambda () (list (call/cc (lambda (out) (guard (e (#t (note 'clause) 'c))
     (dynamic-wind (lambda () (note 'in)) (lambda () (raise 'x)) (lambda () (note 'out) (out 'from-after))))))
     (guard (e (#t 'fresh)) (raise 'later)))))
;; n5 an ordinary escape whose after thunk jumps back into its own frame (call/cc still live)
(set! flag 0)
(run 'n5 (lambda () (call/cc (lambda (out)
   (dynamic-wind (lambda () (note 'in))
     (lambda () (list 'resumed (call/cc (lambda (kin) (set! kk kin) (out 'left)))))
     (lambda () (note 'out) (when (= flag 0) (set! flag 1) (kk 'again))))))))
;; n6 a guard inside a handler
(run 'n6 (lambda () (with-exception-handler
   (lambda (c) (guard (e (#t (list 'inner-caught e))) (raise (list 'wrapped c))))
   (lambda () (raise-continuable 'a)))))
;; n7 a handler that uses a non-matching guard and dynamic-wind
(run 'n7 (lambda () (with-exception-handler (lambda (c) (note (list 'outer c)) 3)
  (lambda () (with-exception-handler
     (lambda (c) (guard (e ((string? e) 's))
                   (dynamic-wind (lambda () (note 'hin)) (lambda () (* 2 (raise-continuable (list 'h c)))) (lambda () (note 'hout)))))
     (lambda () (+ 1 (raise-continuable 'a))))))))
;; n8 raise inside a clause body
(run 'n8 (lambda () (guard (e (#t (note 'clause) (raise (list 'from-clause e))))
     (dynamic-wind (lambda () (note 'in)) (lambda () (raise 'x)) (lambda () (note 'out))))))
;; n9 an escape crossing two guards, then a later raise
(run 'n9 (lambda () (list (call/cc (lambda (k) (guard (e (#f 1))
   (dynamic-wind (lambda () (note 'in1))
     (lambda () (guard (e (#f 2)) (dynamic-wind (lambda () (note 'in2)) (lambda () (k 'out)) (lambda () (note 'out2)))))
     (lambda () (note 'out1))))))
   (guard (e (#t 'fresh)) (raise 'later)))))
;; n10 a clause test escapes to a continuation captured outside the guard, then a later raise
(run 'n10 (lambda () (list (call/cc (lambda (k) (guard (e ((k (list 'from-test e)) 'never))
   (dynamic-wind (lambda () (note 'in)) (lambda () (raise 'x)) (lambda () (note 'out))))))
   (guard (e (#t 'fresh)) (raise 'later)))))
;; n11 handler inside dynamic-wind inside a non-matching guard, outer handler returns
(run 'n11 (lambda () (with-exception-handler (lambda (c) (note (list 'outer c)) 100)
  (lambda () (guard (e ((string? e) 's))
    (dynamic-wind (lambda () (note 'in))
      (lambda () (with-exception-handler (lambda (c) (note (list 'inner c)) (+ 1 (raise-continuable c)))
                   (lambda () (+ 1000 (raise-continuable 'q)))))
      (lambda () (note 'out))))))))
;; n12 a raise from an after thunk during an ordinary escape
(run 'n12 (lambda () (call/cc (lambda (k) (dynamic-wind (lambda () (note 'in)) (lambda () (k 'escaped)) (lambda () (note 'out) (raise 'from-after)))))))
;; n12b the same with raise-continuable answered by a handler outside: the escape completes
(run 'n12b (lambda () (with-exception-handler (lambda (c) (note (list 'h c)) 0)
  (lambda () (call/cc (lambda (k) (dynamic-wind (lambda () (note 'in)) (lambda () (k 'escaped)) (lambda () (note 'out) (raise-continuable 'from-after)))))))))
;; n13 deep: 300 nested non-matching guards with dynamic-wind, raise at the bottom
(define (deep n) (if (= n 0) (raise 'bottom)
   (guard (e ((eq? e n) 'no)) (dynamic-wind (lambda () (set! cnt (+ cnt 1))) (lambda () (deep (- n 1))) (lambda () (set! cnt (+ cnt 1)))))))
(set! cnt 0)
(run 'n13 (lambda () (let ((r (deep 300))) (list r cnt))))
(run 'n13b (lambda () (list cnt)))
;; n14 values
(run 'n14a (lambda () (call-with-values (lambda () (with-exception-handler (lambda (c) (values 1 2)) (lambda () (raise-continuable 'a)))) list)))
(run 'n14b (lambda () (call-with-values (lambda () (guard (e (#t (values 3 4))) (raise 'a))) list)))
(run 'n14c (lambda () (call-with-values (lambda () (guard (e (#t 0)) (values))) list)))
(run 'n14d (lambda () (call-with-values (lambda () (dynamic-wind (lambda () #f) (lambda () (values 5 6)) (lambda () #f))) list)))
(run 'n14e (lambda () (with-exception-handler (lambda (c) (values 7 8))
   (lambda () (call-with-values (lambda () (guard (e ((string? e) 's)) (raise-continuable 'a))) list)))))
;; n15 raise (not continuable) through a non-matching guard; the outer handler returns
(run 'n15 (lambda () (with-exception-handler (lambda (c) (note (list 'h (if (nc? c) 'nc c))) 7)
  (lambda () (guard (e ((string? e) 's))
     (dynamic-wind (lambda () (note 'in)) (lambda () (raise 'sym)) (lambda () (note 'out))))))))
;; n16 an after thunk raises a second non-matching object during the leave; the outer handler returns
(set! flag 0)
(run 'n16 (lambda () (with-exception-handler (lambda (c) (note (list 'h c)) 1)
  (lambda () (guard (e ((string? e) 's))
     (dynamic-wind (lambda () (note 'in))
                     (lambda () (+ 10 (raise-continuable 'first)))
                     (lambda () (note 'out) (when (= flag 0) (set! flag 1) (note (list 'aret (raise-continuable 'from-after)))))))))))
;; n17 the outer handler escapes into the body (continuation taken inside the body)
(run 'n17 (lambda () (with-exception-handler (lambda (c) (kk (list 'resumed c)))
  (lambda () (guard (e ((string? e) 's))
     (dynamic-wind (lambda () (note 'in))
        (lambda () (list 'body (call/cc (lambda (k) (set! kk k) (raise 'x)))))
        (lambda () (note 'out))))))))
;; n18 a before thunk escapes during the re-entry to a continuation outside the guard
(set! cnt 0)
(run 'n18 (lambda () (call/cc (lambda (out) (with-exception-handler (lambda (c) (note (list 'h c)) 1)
  (lambda () (guard (e ((string? e) 's))
     (dynamic-wind (lambda () (set! cnt (+ cnt 1)) (note (list 'in cnt)) (when (= cnt 2) (out 'from-before)))
                     (lambda () (+ 10 (raise-continuable 'sym)))
                     (lambda () (note 'out))))))))))
;; n19 a handler (not a guard) escapes; a later raise goes to the right place
(run 'n19 (lambda () (list (call/cc (lambda (k) (with-exception-handler (lambda (c) (k (list 'handled c))) (lambda () (raise 'a)))))
                          (guard (e (#t 'fresh)) (raise 'later)))))
;; n20 the guard's handler is no longer installed after a matching clause runs
(run 'n20 (lambda () (with-exception-handler (lambda (c) (note (list 'outer c)) 9)
  (lambda () (+ (guard (e (#t (raise-continuable (list 'in-clause e)))) (raise 'a))
                (raise-continuable 'after-guard))))))
;; n21 after thunk jumps back into the body during the guard's leave (continuation inside its own frame)
(set! flag 0)
(run 'n21 (lambda () (guard (e ((symbol? e) (note (list 'clause e)) e))
   (dynamic-wind (lambda () (note 'in))
     (lambda () (list 'resumed (call/cc (lambda (kin) (set! kk kin) (raise 'x)))))
     (lambda () (note 'out) (when (= flag 0) (set! flag 1) (kk 'again)))))))
;; n22 raise-continuable with a handler returning, inside a dynamic-wind inside the handler stack frame; nested raise in handler with dw
(run 'n22 (lambda () (with-exception-handler (lambda (c) (note (list 'outer c)) 2)
  (lambda () (with-exception-handler
    (lambda (c) (dynamic-wind (lambda () (note 'hin)) (lambda () (+ 1 (raise-continuable (list 'again c)))) (lambda () (note 'hout))))
    (lambda () (* 10 (raise-continuable 'a))))))))

;; n17b recovered warning then an early exit through a continuation taken inside the dynamic-wind
(run 'n17b (lambda () (with-exception-handler (lambda (c) (note (list 'h c)) 0)
  (lambda () (guard (e ((string? e) 's))
     (dynamic-wind (lambda () (note 'in))
        (lambda () (call/cc (lambda (k) (raise-continuable 'warn) (k 'jumped) 'not-reached)))
        (lambda () (note 'out))))))))

;; n23 two nested guards both re-raise once (outer handler returns); then the INNER guard catches a second raise
(run 'n23 (lambda () (with-exception-handler (lambda (c) (note (list 'h c)) 1)
 (lambda ()
  (guard (e ((string? e) 'g1))
   (dynamic-wind (lambda () (note 'in1))
     (lambda ()
       (guard (e ((eq? e 'y) (note 'g2-caught) 'g2))
         (dynamic-wind (lambda () (note 'in2))
           (lambda () (let* ((a (raise-continuable 'x)) (b (raise 'y))) (+ a b)))
           (lambda () (note 'out2)))))
     (lambda () (note 'out1))))))))
(run 'n23-after (lambda () (guard (e (#t (list 'fresh e))) (raise 'later))))

(define expected
  '((w1 11 ((h c1)))
    (w2 (escaped non-continuable) (inner outer))
    (w3 101 ((inner first) (outer again)))
    (w4 8 ((h sym)))
    (w5 8 (in out in (h sym) out))
    (w6 outer (in out in out outer-clause))
    (w7 matched ())
    (w8 caught (in out clause))
    (w9 (42 (b . 23)) ())
    (w10 (left fresh) ())
    (w14 (escaped 42) ())
    (w15 (1 2) ())
    (w16 (1 2 3) ())
    (w17 from-after (in out (clause from-after)))
    (w18 15 (in (inner q) out in (outer q) out))
    (w19 (body via-test) (in out in out))
    (n1 tested (in out (h (test b))))
    (n2 (escaped (test b)) (in out))
    (n3 11 ((in 1) out (in 2) (h from-before) (bret 1) (h sym) out))
    (n4 (from-after fresh) (in out))
    (n5 (resumed again) (in out in out))
    (n6 (inner-caught (wrapped a)) ())
    (n7 7 (hin hout hin (outer (h a)) hout))
    (n8 (escaped (from-clause x)) (in out clause))
    (n9 (out fresh) (in1 in2 out2 out1))
    (n10 ((from-test x) fresh) (in out))
    (n11 1101 (in (inner q) out in (outer q) out))
    (n12 (escaped from-after) (in out))
    (n12b escaped (in out (h from-after)))
    (n13 (escaped bottom) ())
    (n13b (90900) ())
    (n14a (1 2) ())
    (n14b (3 4) ())
    (n14c () ())
    (n14d (5 6) ())
    (n14e (7 8) ())
    (n15 (escaped non-continuable) (in out in (h sym) (h nc) out))
    (n16 11 (in out (h from-after) (aret 1) in (h first) out))
    (n17 (body (resumed x)) (in out in out))
    (n18 from-before ((in 1) out (in 2)))
    (n19 ((handled a) fresh) ())
    (n20 18 ((outer (in-clause a)) (outer after-guard)))
    (n21 (resumed again) (in out in out))
    (n22 30 (hin (outer (again a)) hout))
    (n17b jumped (in out in (h warn) out))
    (n23 g2 (in1 in2 out2 in2 out2 out1 in1 in2 (h x) out2 g2-caught out1))
    (n23-after (fresh later) ())))

(define (differing got want)
  (cond ((and (null? got) (null? want)) '())
        ((null? got) (list (list 'missing (car want))))
        ((null? want) (list (list 'extra (car got))))
        ((equal? (car got) (car want)) (differing (cdr got) (cdr want)))
        (else (cons (list 'got (car got) 'want (car want))
                    (differing (cdr got) (cdr want))))))
(display (let ((d (differing (reverse results) expected))) (if (null? d) #t d)))
