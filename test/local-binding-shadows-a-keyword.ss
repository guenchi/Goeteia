;; expect: #t
;; A local binding shadows a keyword, and every other name a pass dispatches
;; on (ledger R43).  Whether a head is a keyword or a variable follows its
;; binding, not its spelling: (let ((if f)) (if 1 2 3 4)) calls f.
;;
;; For each spelling the expander or a later pass knows -- the core and
;; derived forms, the auxiliaries, apply and call/cc, and list, vector and
;; cons as controls -- bound to a procedure that answers (called . args):
;;   let lambda rest          a let binding, a formal, a rest formal
;;   define-formal            a top-level procedure's formal
;;   internal internal-header a body's own definition, both shapes
;;   procedure-body           the same inside a top-level procedure's body
;;   letrec named-let         and a named let's name
;;   closure                  called from a lambda that captured it
;;   nested                   rebound inside, and the outer one again after
;;   value set                bound to a number and read; assigned
;; Every answer is the one Chez 10 gives.
;;
;; ON THE TREE BEFORE THE CHANGE this file does not compile: the compiler
;; takes (if 1 2) under a local if for a malformed if, and fails on a local
;; let, lambda or set!.
(import (rnrs))

(define fails '())
(define (want name got expect)
  (unless (equal? got expect)
    (set! fails (cons (list name 'got got 'want expect) fails))))
(define rows '())
(define (row! name thunk expect) (set! rows (cons (list name thunk expect) rows)))

(define (tag . args) (cons 'called args))
