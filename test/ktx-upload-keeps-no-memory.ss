;; expect: #t
;; The texture uploads of (gfx ktx) give their staging back (ledger R90,
;; batch M52): ktx-upload! decodes level 0 into a buffer from the bump heap
;; and hands it to gl-texture-data!; ktx-upload-basis! transcodes into one
;; and hands it to gl-texture-data! (RGBA, when the context has no block
;; family) or, level by level, to gl-compressed-level!.  The replayer's
;; texture calls copy the bytes when they are made, so nothing reads the
;; buffer after the upload returns, and the water level (fx-mark) must be
;; where it was before the call.
;;
;; Three sites, one row each, twenty calls after a first: UASTC (raw and
;; zstd) through ktx-upload!; ETC1S with no block family (RGBA); ETC1S with
;; ETC1 (compressed levels).  The stub GL of (glstate) offers no extension,
;; so its context is wrapped here: getExtension answers ETC1 while the JS
;; global __ktxFamily is "etc1", and the two upload calls keep a copy of
;; the bytes they were given, so the last upload is compared with what it
;; must carry -- the golden RGBA of each file's level 0, and for ETC1 the
;; transcode of each level into a buffer of the cell's own.
;;
;; Fixtures from test/ktx-uastc-zstd-keeps-no-memory.ss and test/ktx.ss,
;; placed with fx-alloc! after fx-init!, below everything the calls take.
;;
;; ON THE TREE BEFORE THE CHANGE the three level rows are red and the
;; upload rows green.
(import (rnrs) (web js) (gfx gl) (gfx fx) (gfx ktx) (glstate))

(define fails '())
(define (want row got expect)
  (unless (equal? got expect)
    (set! fails (cons (list row 'got got 'want expect) fails))))

(js-eval "globalThis.__ktxFamily = 'none'; globalThis.__ktxUploads = []; globalThis.__ktxWrap = (canvas) => { const get = canvas.getContext.bind(canvas); canvas.getContext = (...a) => { const ctx = get(...a); if (!ctx) return ctx; return new Proxy(ctx, { get(t, k) { if (k === 'getExtension') return name => (globalThis.__ktxFamily === 'etc1' && name === 'WEBGL_compressed_texture_etc1') ? { COMPRESSED_RGB_ETC1_WEBGL: 36196 } : null; if (k === 'texImage2D' || k === 'compressedTexImage2D') return (...b) => { globalThis.__ktxUploads.push(Array.from(b[b.length - 1])); return t[k](...b); }; return t[k]; } }); }; return canvas; }; 0")
(define canvas (glstate-canvas 64 64))
(js-call (js-get (js-global) "__ktxWrap") (js-undefined) canvas)
(fx-init! canvas)

(define (uploads) (js-get (js-global) "__ktxUploads"))
(define (forget-uploads!) (js-set! (js-global) "__ktxUploads" (js-new (js-get (js-global) "Array"))))
(define (upload-count) (js->number (js-get (uploads) "length")))
(define (upload i)
  (let* ((a (js-index (uploads) i)) (n (js->number (js-get a "length"))))
    (let loop ((j (- n 1)) (out '()))
      (if (< j 0) out (loop (- j 1) (cons (js->number (js-index a j)) out))))))
(define (mem->list at n)
  (let loop ((j (- n 1)) (out '()))
    (if (< j 0) out (loop (- j 1) (cons (%mem-u8-ref (+ at j)) out)))))
(define (llen l) (let loop ((l l) (n 0)) (if (null? l) n (loop (cdr l) (+ n 1)))))
(define (place! bs)
  (let ((base (fx-alloc! (llen bs))))
    (let put ((b bs) (i 0))
      (when (pair? b) (%mem-u8-set! (+ base i) (car b)) (put (cdr b) (+ i 1))))
    base))
(define (repeat! n thunk) (when (> n 0) (thunk) (repeat! (- n 1) thunk)))
(define (level-rise thunk)
  (thunk)
  (let ((before (fx-mark)))
    (repeat! 20 thunk)
    (- (fx-mark) before)))

