;; level 1 golden RGBA (reference transcoder ETC1 unpack)

(define kraw (ktx-parse (place! ktx-raw) (llen ktx-raw)))
(define kzst (ktx-parse (place! ktx-zstd) (llen ktx-zstd)))
(define ketc (ktx-parse (place! ktx2-bytes) (llen ktx2-bytes)))
(want 'files-are-what-the-rows-need
      (list (ktx-uastc? kraw) (ktx-scheme kraw) (ktx-uastc? kzst) (ktx-scheme kzst)
            (ktx-etc1s? ketc) (ktx-alpha? ketc) (ktx-level-count ketc))
      '(#t 0 #t 2 #t #f 5))

;; ETC1, the expected bytes: each level transcoded into the cell's own buffer
(define etc1-levels
  (let loop ((l 0) (out '()))
    (if (= l 5)
        (reverse out)
        (let* ((n (ktx-transcode-bytes ketc l 'etc1)) (at (fx-alloc! n)))
          (ktx-transcode! ketc l at 'etc1)
          (loop (+ l 1) (cons (mem->list at n) out))))))

;; site 180: ktx-upload! of a UASTC file, raw and supercompressed
(forget-uploads!)
(want 'uastc-raw-level-rise (level-rise (lambda () (ktx-upload! kraw))) 0)
(want 'uastc-raw-last-upload (upload (- (upload-count) 1)) rgba-gold)
(forget-uploads!)
(want 'uastc-zstd-level-rise (level-rise (lambda () (ktx-upload! kzst))) 0)
(want 'uastc-zstd-last-upload (upload (- (upload-count) 1)) rgba-gold)

;; site 192: ETC1S on a context with no block family, RGBA
(forget-uploads!)
(want 'etc1s-rgba-level-rise (level-rise (lambda () (ktx-upload! ketc))) 0)
(want 'etc1s-rgba-last-upload (upload (- (upload-count) 1)) golden-l0)

;; site 200: ETC1S on a context with ETC1, every level compressed
(js-set! (js-global) "__ktxFamily" "etc1")
(forget-uploads!)
(want 'etc1s-etc1-level-rise (level-rise (lambda () (ktx-upload! ketc))) 0)
(want 'etc1s-etc1-uploads (upload-count) (* 21 5))
(want 'etc1s-etc1-last-call-levels
      (let loop ((l 0) (out '()))
        (if (= l 5) (reverse out) (loop (+ l 1) (cons (upload (+ (- (upload-count) 5) l)) out))))
      etc1-levels)

(display (if (null? fails) #t (reverse fails)))
